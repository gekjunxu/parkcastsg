# Host port used by Docker Compose.
PARKCAST_PORT=8080

# Optional. Request a personal key from https://datamall.lta.gov.sg/
LTA_API_KEY=

# Only needed when a separately hosted frontend calls this API.
CORS_ALLOW_ORIGINS=

# OneMap credentials for server-side destination autocomplete.
# Add these as GitHub staging environment secrets; do not commit real values.
ONEMAP_API_EMAIL=
ONEMAP_API_PASSWORD=
